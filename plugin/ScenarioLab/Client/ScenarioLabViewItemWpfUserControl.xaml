<!--
  Layout of the Scenario Lab panel. XAML (Extensible Application Markup Language) describes WPF controls the way
  HTML describes a page; the matching .xaml.cs file holds the code. x:Name gives a control a field name in code.

  Three columns:  1. Cameras  |  2. Live view + snapshot  |  3. Scenario, generated clips, Hafnia results
-->
<platformclient:ViewItemWpfUserControl x:Class="ScenarioLab.Client.ScenarioLabViewItemWpfUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:platformclient="clr-namespace:VideoOS.Platform.Client;assembly=VideoOS.Platform"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1200"
             PreviewMouseLeftButtonUp="OnMouseLeftUp" Background="Transparent">
    <platformclient:ViewItemWpfUserControl.Resources>
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </platformclient:ViewItemWpfUserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Cameras -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource StepHeader}" Text="1. Cameras"/>
            <Button Padding="10,4" DockPanel.Dock="Bottom" x:Name="_refreshCamerasButton" Content="Refresh list"
                    HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnRefreshCameras"/>
            <ListBox x:Name="_cameraList" DisplayMemberPath="Name" SelectionChanged="OnCameraSelected"/>
        </DockPanel>

        <!-- 2. Live view and snapshot -->
        <Grid Grid.Column="1" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource StepHeader}" Text="2. Live view and snapshot"/>
            <!-- The XProtect image viewer is created in code (it needs this view item's WindowInformation). -->
            <Grid Grid.Row="1" x:Name="_liveViewHost" Background="#20000000">
                <TextBlock x:Name="_liveViewPlaceholder" Text="Select a camera on the left"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                <Button Padding="10,4" Margin="0,0,6,0" x:Name="_snapshotButton" Content="Take snapshot" IsEnabled="False" Click="OnTakeSnapshot"/>
                <Button Padding="10,4" Margin="0,0,6,0" x:Name="_openSnapshotsButton" Content="Open snapshot folder" Click="OnOpenSnapshotFolder"/>
            </StackPanel>
            <DockPanel Grid.Row="3">
                <TextBlock DockPanel.Dock="Bottom" x:Name="_snapshotInfo" Style="{StaticResource Hint}"
                           Text="No snapshot yet."/>
                <Border BorderThickness="1" BorderBrush="#40808080">
                    <Image x:Name="_snapshotImage" Stretch="Uniform"/>
                </Border>
            </DockPanel>
        </Grid>

        <!-- 3. Scenario, generated clips, Hafnia results -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource StepHeader}" Text="3. Scenario"/>
                <TextBox x:Name="_scenarioText" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="Example: a person climbs over the fence on the left and runs towards the building."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_saveScenarioButton" Content="Save scenario" IsEnabled="False" Click="OnSaveScenario"/>
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_suggestButton" Content="Suggest scenarios" IsEnabled="False"
                            ToolTip="Not connected yet: an LLM will propose scenarios from the snapshot."/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Saving writes the scenario next to the snapshot, as input for video generation."/>

                <TextBlock Style="{StaticResource StepHeader}" Text="4. Generated clips" Margin="0,18,0,6"/>
                <ListBox x:Name="_clipList" Height="110" DisplayMemberPath="Name" SelectionChanged="OnClipSelected"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Padding="10,4" Margin="0,0,6,0" Content="Refresh" Click="OnRefreshClips"/>
                    <Button Padding="10,4" Margin="0,0,6,0" Content="Open clip folder" Click="OnOpenClipFolder"/>
                </StackPanel>
                <Border BorderThickness="1" BorderBrush="#40808080" Margin="0,8,0,0" Height="200" Background="#20000000">
                    <MediaElement x:Name="_player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                  MediaEnded="OnPlayerEnded" MediaFailed="OnPlayerFailed"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_playButton" Content="Play" IsEnabled="False" Click="OnPlay"/>
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_stopButton" Content="Stop" IsEnabled="False" Click="OnStop"/>
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_openExternalButton" Content="Open in player" IsEnabled="False" Click="OnOpenExternal"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Local files for now. Later these will be XProtect recordings of the generated clips."/>

                <TextBlock Style="{StaticResource StepHeader}" Text="5. Hafnia results" Margin="0,18,0,6"/>
                <Border BorderThickness="1" BorderBrush="#40808080" Padding="8">
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Not connected in this build: no Hafnia requests are sent. Answers and alarms will appear here."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status line -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="_status" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.85"/>
    </Grid>
</platformclient:ViewItemWpfUserControl>
