<!--
  Layout of the Scenario Lab panel. XAML (Extensible Application Markup Language) describes WPF controls the way
  HTML describes a page; the matching .xaml.cs file holds the code. x:Name gives a control a field name in code.

  Three columns:  1. Cameras  |  2. Live view + snapshot  |  3. Scenario, generated clips, Hafnia results
-->
<platformclient:ViewItemWpfUserControl x:Class="ScenarioLab.Client.ScenarioLabViewItemWpfUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:platformclient="clr-namespace:VideoOS.Platform.Client;assembly=VideoOS.Platform"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1200"
             PreviewMouseLeftButtonUp="OnMouseLeftUp" Background="Transparent">
    <platformclient:ViewItemWpfUserControl.Resources>
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </platformclient:ViewItemWpfUserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Cameras -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource StepHeader}" Text="1. Cameras"/>
            <Button Padding="10,4" DockPanel.Dock="Bottom" x:Name="_refreshCamerasButton" Content="Refresh list"
                    HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnRefreshCameras"/>
            <ListBox x:Name="_cameraList" DisplayMemberPath="Name" SelectionChanged="OnCameraSelected"/>
        </DockPanel>

        <!-- 2. Live view, then pick a recorded frame and save it as the snapshot -->
        <Grid Grid.Column="1" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource StepHeader}" Text="2. Live view"/>
            <!-- The XProtect image viewer is created in code (it needs this view item's WindowInformation). -->
            <Grid Grid.Row="1" x:Name="_liveViewHost" Background="#20000000">
                <TextBlock x:Name="_liveViewPlaceholder" Text="Select a camera on the left"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
            </Grid>

            <TextBlock Grid.Row="2" Style="{StaticResource StepHeader}" Margin="0,12,0,6"
                       Text="Pick a frame from the recording (original resolution)"/>
            <Border Grid.Row="3" BorderThickness="1" BorderBrush="#40808080" Background="#20000000">
                <Grid>
                    <Image x:Name="_frameImage" Stretch="Uniform"/>
                    <TextBlock x:Name="_framePlaceholder" Text="The recorded frame appears here"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                </Grid>
            </Border>

            <!-- Slider: seconds relative to "now" (when the camera was picked or Now was pressed). 0 = latest. -->
            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <ComboBox DockPanel.Dock="Right" x:Name="_rangeBox" Width="130" Margin="8,0,0,0"
                          SelectionChanged="OnRangeChanged">
                    <ComboBoxItem Content="Last 2 minutes" Tag="120"/>
                    <ComboBoxItem Content="Last 10 minutes" Tag="600" IsSelected="True"/>
                    <ComboBoxItem Content="Last hour" Tag="3600"/>
                    <ComboBoxItem Content="Last 24 hours" Tag="86400"/>
                </ComboBox>
                <Slider x:Name="_timeSlider" Minimum="-600" Maximum="0" Value="0" IsEnabled="False"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
            </DockPanel>
            <DockPanel Grid.Row="5" Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_prevFrameButton" Content="◀ Frame" IsEnabled="False"
                            ToolTip="Previous recorded frame" Click="OnPreviousFrame"/>
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_nextFrameButton" Content="Frame ▶" IsEnabled="False"
                            ToolTip="Next recorded frame" Click="OnNextFrame"/>
                    <Button Padding="10,4" Margin="0,0,12,0" x:Name="_nowButton" Content="Now" IsEnabled="False"
                            ToolTip="Jump to the latest recorded frame" Click="OnNow"/>
                </StackPanel>
                <TextBlock x:Name="_frameTimeText" VerticalAlignment="Center" Text="" Opacity="0.85"/>
            </DockPanel>
            <StackPanel Grid.Row="6" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_snapshotButton" Content="Save this frame as snapshot"
                            IsEnabled="False" Click="OnTakeSnapshot"/>
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_openSnapshotsButton" Content="Open snapshot folder"
                            Click="OnOpenSnapshotFolder"/>
                </StackPanel>
                <TextBlock x:Name="_snapshotInfo" Style="{StaticResource Hint}" Text="No snapshot yet."/>
            </StackPanel>
        </Grid>

        <!-- 3. Scenario, generated clips, Hafnia results -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource StepHeader}" Text="3. Scenario"/>
                <TextBox x:Name="_scenarioText" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="Example: a person climbs over the fence on the left and runs towards the building."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_saveScenarioButton" Content="Save scenario" IsEnabled="False" Click="OnSaveScenario"/>
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_suggestButton" Content="Suggest scenarios" IsEnabled="False"
                            ToolTip="Not connected yet: an LLM will propose scenarios from the snapshot."/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Saving writes the scenario next to the snapshot, as input for video generation."/>

                <TextBlock Style="{StaticResource StepHeader}" Text="4. Generated clips" Margin="0,18,0,6"/>
                <ListBox x:Name="_clipList" Height="110" DisplayMemberPath="Name" SelectionChanged="OnClipSelected"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Padding="10,4" Margin="0,0,6,0" Content="Refresh" Click="OnRefreshClips"/>
                    <Button Padding="10,4" Margin="0,0,6,0" Content="Open clip folder" Click="OnOpenClipFolder"/>
                </StackPanel>
                <Border BorderThickness="1" BorderBrush="#40808080" Margin="0,8,0,0" Height="200" Background="#20000000">
                    <MediaElement x:Name="_player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                  MediaEnded="OnPlayerEnded" MediaFailed="OnPlayerFailed"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_playButton" Content="Play" IsEnabled="False" Click="OnPlay"/>
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_stopButton" Content="Stop" IsEnabled="False" Click="OnStop"/>
                    <Button Padding="10,4" Margin="0,0,6,0" x:Name="_openExternalButton" Content="Open in player" IsEnabled="False" Click="OnOpenExternal"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Local files for now. Later these will be XProtect recordings of the generated clips."/>

                <!-- 5. Test a detection question with Hafnia VLM -->
                <TextBlock Style="{StaticResource StepHeader}" Text="5. Test with Hafnia" Margin="0,18,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" x:Name="_connectButton"
                            Content="Connect" Click="OnConnectHafnia"/>
                    <PasswordBox x:Name="_gatewayPassword" VerticalContentAlignment="Center"
                                 ToolTip="Hafnia gateway password (administrator = your Windows password). Kept in memory only."/>
                </DockPanel>
                <TextBlock x:Name="_hafniaState" Style="{StaticResource Hint}"
                           Text="Not connected. Type the gateway password (your Windows password) and press Connect. It is never saved."/>

                <TextBlock Text="Detection question" Margin="0,10,0,2"/>
                <TextBox x:Name="_detectionQuestion" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="Is someone throwing an object at a building or breaking a window in this video?"/>
                <DockPanel Margin="0,6,0,0">
                    <ComboBox DockPanel.Dock="Right" x:Name="_expectedBox" Width="150" Margin="6,0,0,0"
                              ToolTip="What should happen on this clip? Used for PASS / FAIL.">
                        <ComboBoxItem Content="Should detect" Tag="detect" IsSelected="True"/>
                        <ComboBoxItem Content="Should NOT detect" Tag="no detect"/>
                    </ComboBox>
                    <Button x:Name="_runTestButton" Padding="10,4" Content="Run test on picked moment" IsEnabled="False"
                            HorizontalAlignment="Left" Click="OnRunTest"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="1 Hafnia request per click: the selected camera, 30 seconds around the picked frame."/>
                <TextBlock x:Name="_runProgress" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <DataGrid x:Name="_runsGrid" Height="150" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="OnRunSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}"/>
                        <DataGridTextColumn Header="Camera" Binding="{Binding Camera}"/>
                        <DataGridTextColumn Header="Expected" Binding="{Binding Expected}"/>
                        <DataGridTextColumn Header="Got" Binding="{Binding Got}"/>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border BorderThickness="1" BorderBrush="#40808080" Padding="8" Margin="0,8,0,0">
                    <TextBlock x:Name="_hafniaAnswer" TextWrapping="Wrap" Opacity="0.9"
                               Text="Hafnia's answer to the selected test appears here."/>
                </Border>
                <TextBlock Style="{StaticResource Hint}"
                           Text="'detected' also raises the XProtect alarm 'Scenario Lab: scenario detected' through the gateway rule. It can take a few minutes to appear in Alarm Manager."/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status line -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="_status" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.85"/>
    </Grid>
</platformclient:ViewItemWpfUserControl>
