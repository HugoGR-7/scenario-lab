<?xml version="1.0" encoding="utf-8"?>
<!--
  Scenario Lab - MIP plug-in for XProtect Smart Client 2026 R1.
  Old-style (non-SDK) project, like Milestone's samples: it is built with the full MSBuild from
  Build Tools for Visual Studio 2022. Target .NET Framework 4.8, never .NET 8.
-->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{0C3F1E47-877D-441C-8086-8E5B655D4936}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ScenarioLab</RootNamespace>
    <AssemblyName>ScenarioLab</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <!-- JavaScriptSerializer: built-in JSON, no extra NuGet package next to Smart Client's own -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
    <!-- 26.1.* = XProtect 2026 R1, the version on the hackathon machine. Never a floating "*-*". -->
    <PackageReference Include="MilestoneSystems.VideoOS.Platform" Version="26.1.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ScenarioLabDefinition.cs" />
    <Compile Include="Client\ScenarioLabWorkSpacePlugin.cs" />
    <Compile Include="Client\ScenarioLabViewItemPlugin.cs" />
    <Compile Include="Client\ScenarioLabViewItemManager.cs" />
    <Compile Include="Client\RecordedFrameFetcher.cs" />
    <Compile Include="Client\TestRun.cs" />
    <Compile Include="Hafnia\HafniaGatewayClient.cs" />
    <Compile Include="Client\ScenarioLabViewItemWpfUserControl.xaml.cs">
      <DependentUpon>ScenarioLabViewItemWpfUserControl.xaml</DependentUpon>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="Client\ScenarioLabViewItemWpfUserControl.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Content Include="plugin.def">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Resource Include="Resources\ScenarioLab.png" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
